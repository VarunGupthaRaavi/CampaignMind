# Port Configuration (No hardcoded ports)
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Environment Mode
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# Supabase PostgreSQL Database URL
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres

# Supabase Authentication Credentials
SUPABASE_URL=https://[YOUR-SUPABASE-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini 2.5 Flash API Key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.5-flash

# Security Secret
SECRET_KEY=super-secret-key-change-in-production
